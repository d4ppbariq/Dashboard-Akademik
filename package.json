{
  "name": "nesaciba-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --conditions=react-server --import tsx \"src/**/*.test.ts\"",
    "ml:extract": "node ml/extract.mjs",
    "ml:train": "python -m ml.train",
    "ml:predict": "python -m ml.predict",
    "ml:publish-b2": "python -m ml.publish_b2",
    "ml:post": "node ml/post.mjs",
    "ml:post:b2": "node ml/post.mjs --b2",
    "ml:test": "python -m unittest discover -s ml/tests -t . -v",
    "db:setup": "tsx src/scripts/db-cli.ts setup",
    "db:migrate": "tsx src/scripts/db-cli.ts migrate",
    "db:seed": "tsx src/scripts/db-cli.ts seed",
    "db:reset": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.9",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
